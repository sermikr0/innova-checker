    "/api/payments/intents": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Create a payment QR code for a plan",
        "description": "Bound to the session's registered device (the fingerprint must match). Any earlier unpaid code of the user is cancelled. The code expires after `paymentWindowSeconds`; Click payments started later are refused.",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceFingerprint"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "plan",
                  "provider"
                ],
                "properties": {
                  "plan": {
                    "type": "string",
                    "description": "Plan slug"
                  },
                  "provider": {
                    "type": "string",
                    "enum": [
                      "CLICK",
                      "CARD"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "QR code issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentIntent"
                }
              }
            }
          },
          "400": {
            "description": "Plan not purchasable with this method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "DEVICE_MISMATCH",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Plan not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Payment method unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/payments/intents/{id}": {
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "Poll payment status",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "$ref": "#/components/schemas/PaymentStatus"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "serverNow": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "paidAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "subscriptionId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "failureReason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/payments/intents/{id}/cancel": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Withdraw an unpaid QR code",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancelled if it was still pending"
          }
        }
      }
    },
    "/pay/{token}": {
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "QR code target",
        "description": "Redirects to Click's payment page while the code is valid; otherwise shows an expired/closed page.",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "To my.click.uz"
          },
          "404": {
            "description": "Unknown code"
          },
          "410": {
            "description": "Expired or closed"
          }
        }
      }
    },
    "/api/payments/click": {
      "post": {
        "tags": [
          "Click callbacks"
        ],
        "summary": "Click SHOP API: Prepare (action=0) and Complete (action=1)",
        "description": "Prepare is accepted only while the QR code is valid. Complete activates the subscription on the paying device. Aliases: `/api/payments/click/prepare`, `/api/payments/click/complete`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ClickRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Click result (check `error`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClickResponse"
                }
              }
            }
          }
        }
      }
    },
