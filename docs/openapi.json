{
  "openapi": "3.1.0",
  "info": {
    "title": "Innova Checker API",
    "version": "1.0.0",
    "description": "URL security analysis for logistics teams, by Innova Networks.\n\n**Authentication.** Browser endpoints use the `ic_session` httpOnly cookie set by `/api/auth/login`. State-changing requests must come from the site's own origin (`Origin` header).\n\n**Device check.** Sign-in, registration, payments and anonymous scans require the `x-innova-device` header: base64url JSON of the browser traits collected by `src/lib/device-fingerprint.ts`. Browsers cannot read MAC addresses; this fingerprint identifies the machine across private windows.\n\n**Brute-force protection.** After the configured number of failed sign-ins (default 5) an IP is blocked from all auth and scan endpoints (`429 IP_BLOCKED`).\n\n**Payments.** `POST /api/payments/intents` returns a QR code valid for `paymentWindowSeconds` (default 180). Click calls `/api/payments/click` (SHOP API Prepare/Complete). The subscription is activated only by a verified Complete callback."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Scans"
    },
    {
      "name": "Payments"
    },
    {
      "name": "Click callbacks",
      "description": "Server-to-server, authenticated by Click's MD5 signature. Configure in the Click merchant cabinet."
    },
    {
      "name": "Account"
    },
    {
      "name": "Admin"
    },
    {
      "name": "Operations"
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ic_session"
      },
      "cronSecret": {
        "type": "http",
        "scheme": "bearer",
        "description": "CRON_SECRET from the server environment."
      }
    },
    "parameters": {
      "DeviceFingerprint": {
        "name": "x-innova-device",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 3000,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "description": "Browser device fingerprint (base64url JSON)."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "examples": [
                  "IP_BLOCKED",
                  "DEVICE_LIMIT",
                  "INVALID_CREDENTIALS"
                ]
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Redirect": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "redirect": {
            "type": "string"
          }
        }
      },
      "Verdict": {
        "type": "string",
        "enum": [
          "TRUSTED",
          "SAFE",
          "LOW_RISK",
          "SUSPICIOUS",
          "HIGH_RISK",
          "MALICIOUS",
          "INCONCLUSIVE"
        ]
      },
      "ScanStatus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "RUNNING",
              "COMPLETED",
              "FAILED"
            ]
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verdict": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Verdict"
              },
              {
                "type": "null"
              }
            ]
          },
          "riskScore": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "deadLink": {
            "type": "boolean",
            "description": "The host does not exist (NXDOMAIN)."
          },
          "url": {
            "type": "string"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PaymentIntent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "description": "Order number sent to Click as merchant_trans_id."
          },
          "status": {
            "$ref": "#/components/schemas/PaymentStatus"
          },
          "provider": {
            "type": "string",
            "enum": [
              "CLICK",
              "CARD"
            ]
          },
          "amount": {
            "type": "integer",
            "description": "Whole so'm for UZS, cents for USD."
          },
          "currency": {
            "type": "string",
            "enum": [
              "UZS",
              "USD"
            ]
          },
          "mock": {
            "type": "boolean",
            "description": "Created in local test mode."
          },
          "plan": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "serverNow": {
            "type": "string",
            "format": "date-time"
          },
          "payUrl": {
            "type": "string",
            "format": "uri",
            "description": "Encoded in the QR code; redirects to Click while valid."
          },
          "qrSvg": {
            "type": "string",
            "description": "SVG markup of the QR code."
          }
        }
      },
      "PaymentStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "PREPARED",
          "PAID",
          "EXPIRED",
          "CANCELLED",
          "FAILED"
        ]
      },
      "ClickRequest": {
        "type": "object",
        "required": [
          "click_trans_id",
          "service_id",
          "merchant_trans_id",
          "amount",
          "action",
          "sign_time",
          "sign_string"
        ],
        "properties": {
          "click_trans_id": {
            "type": "string"
          },
          "service_id": {
            "type": "string"
          },
          "click_paydoc_id": {
            "type": "string"
          },
          "merchant_trans_id": {
            "type": "string",
            "description": "PaymentIntent.number"
          },
          "merchant_prepare_id": {
            "type": "string",
            "description": "Complete only."
          },
          "amount": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "0",
              "1"
            ],
            "description": "0 = Prepare, 1 = Complete"
          },
          "error": {
            "type": "string"
          },
          "error_note": {
            "type": "string"
          },
          "sign_time": {
            "type": "string",
            "examples": [
              "2026-11-14 10:00:00"
            ]
          },
          "sign_string": {
            "type": "string",
            "description": "md5(click_trans_id + service_id + SECRET_KEY + merchant_trans_id [+ merchant_prepare_id] + amount + action + sign_time)"
          }
        }
      },
      "ClickResponse": {
        "type": "object",
        "properties": {
          "click_trans_id": {
            "type": "string"
          },
          "merchant_trans_id": {
            "type": "string"
          },
          "merchant_prepare_id": {
            "type": "integer"
          },
          "merchant_confirm_id": {
            "type": "integer"
          },
          "error": {
            "type": "integer",
            "description": "0 success, -1 sign failed, -2 amount, -3 action, -4 already paid, -5 order not found, -6 transaction not found, -7 update failed, -8 bad request, -9 cancelled (expired QR, failed payment)"
          },
          "error_note": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create an account and sign in on this device",
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceFingerprint"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fullName",
                  "email",
                  "companyName",
                  "password",
                  "confirmPassword"
                ],
                "properties": {
                  "fullName": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "companyName": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "confirmPassword": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Redirect"
                }
              }
            }
          },
          "400": {
            "description": "Validation or device check failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Registration disabled or device limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "E-mail taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited or IP blocked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in; registers this device if it is new",
        "description": "Each failed attempt counts against the caller's IP. When the limit is reached the IP is blocked (`IP_BLOCKED`). The account is also locked separately after repeated failures (`ACCOUNT_LOCKED`).",
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceFingerprint"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  },
                  "next": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in; sets ic_session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Redirect"
                }
              }
            }
          },
          "400": {
            "description": "Device check failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Incorrect e-mail or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Account disabled or DEVICE_LIMIT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "ACCOUNT_LOCKED, IP_BLOCKED or rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign out this session",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Signed out"
          }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Send a password-reset link",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Always succeeds (no account enumeration)"
          },
          "429": {
            "description": "Rate limited or IP blocked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Set a new password with a reset token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "password",
                  "confirmPassword"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "confirmPassword": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password changed; all sessions revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Redirect"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "IP blocked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/consent/start": {
      "post": {
        "tags": [
          "Terms of Use"
        ],
        "summary": "Accept the Terms of Use with first and last name and e-mail",
        "description": "Required once before the first check when Admin → Site controls asks for it (the scan API answers 428 `CONSENT_REQUIRED`). Records the acceptance (time, Terms version, language, IP, country, browser, device) and sets the `ic_consent` cookie. When e-mail confirmation is on and SMTP is configured, sends a 6-digit code valid for 10 minutes. Signed-in users always confirm their account e-mail.",
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceFingerprint"
          }
        ],
        "security": [
          {},
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fullName",
                  "email",
                  "accept",
                  "termsVersion"
                ],
                "properties": {
                  "fullName": {
                    "type": "string",
                    "description": "First and last name (at least two words)"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "accept": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "termsVersion": {
                    "type": "string",
                    "example": "2026-11-17"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Next step",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "step": {
                      "type": "string",
                      "enum": [
                        "verify",
                        "done"
                      ]
                    },
                    "email": {
                      "type": "string",
                      "description": "Masked address the code was sent to"
                    },
                    "resendIn": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Terms not accepted, invalid name or e-mail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "TERMS_UPDATED: reload and accept the current version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "EMAIL_SEND_FAILED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/consent/verify": {
      "post": {
        "tags": [
          "Terms of Use"
        ],
        "summary": "Confirm the e-mail with the 6-digit code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "step": {
                      "type": "string",
                      "enum": [
                        "done"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "CODE_INVALID, CODE_EXPIRED or CONSENT_NOT_STARTED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "CODE_LOCKED after 5 wrong codes, or rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/consent/resend": {
      "post": {
        "tags": [
          "Terms of Use"
        ],
        "summary": "Send a new code (at most once a minute)",
        "responses": {
          "200": {
            "description": "Next step",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "step": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "resendIn": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "CONSENT_NOT_STARTED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/scans": {
      "post": {
        "tags": [
          "Scans"
        ],
        "summary": "Start a URL scan",
        "description": "Signed-in users need an active subscription on a registered device (Super Admin and Unlimited roles excepted). Without a subscription, visitors and signed-in users get the free allowance set in Admin → Site controls (unlimited, N per day or N in total), counted per device fingerprint, plus a per-IP daily ceiling for visitors. When the allowance is used up the API returns 403 FREE_SCAN_USED (visitors) or 402 SUBSCRIPTION_REQUIRED (signed-in users).",
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceFingerprint",
            "required": false,
            "description": "Required for anonymous scans."
          }
        ],
        "security": [
          {},
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "maxLength": 2048
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Scan queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL or device check failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Subscription required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FREE_SCAN_USED, DEVICE_LIMIT_EXCEEDED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "428": {
            "description": "CONSENT_REQUIRED: accept the Terms of Use (POST /api/consent/start) first; `step` is terms or verify",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited or IP blocked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Maintenance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/scans/{id}": {
      "get": {
        "tags": [
          "Scans"
        ],
        "summary": "Scan status and verdict",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanStatus"
                }
              }
            }
          },
          "404": {
            "description": "Not found or not yours",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/scans/{id}/pdf": {
