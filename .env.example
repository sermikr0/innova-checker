# ─── Innova Checker environment ───────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# PostgreSQL (docker compose uses the POSTGRES_* values)
POSTGRES_USER=innova
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=innova_checker
POSTGRES_PORT=5442
DATABASE_URL=postgresql://innova:change-me-to-a-long-random-string@127.0.0.1:5442/innova_checker?schema=public

# Public base URL of the app (used for links in e-mails and CSRF origin checks)
APP_URL=http://localhost:3000

# Secret for hashing visitor IPs (min. 32 chars): openssl rand -hex 32
IP_HASH_SECRET=

# Number of reverse proxies in front of the app that append to X-Forwarded-For.
# 0 = app is exposed directly (IP-based anonymous limits are best-effort only).
TRUSTED_PROXY_COUNT=0

# Super Admin created by `npm run db:seed` (password: >= 12 chars, letters + digits).
# These are the DEVELOPMENT credentials from the project brief. Use different,
# secret values in production.
SUPER_ADMIN_EMAIL=admin@example.com
# Set a long random password for the first seed, then remove it from .env.
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Innova Super Admin

# Optional demo user with a Monthly plan (local development only)
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=

# Encrypts provider API keys saved in Admin → Integrations: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=
# VirusTotal requests per minute allowed by your key (public API: 4)
VIRUSTOTAL_REQUESTS_PER_MINUTE=4

# Optional threat-intelligence providers (leave empty = "Not configured").
# Keys can also be set or replaced in Admin → Integrations (stored encrypted, overrides these).
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_AUTH_KEY=
PHISHTANK_APP_KEY=
ABUSEIPDB_API_KEY=

# Optional SMTP for password-reset e-mails (without it, links are logged / shown in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Scheduled domain revalidation + threat-feed sync
# External cron: POST /api/cron/domain-intel with "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Or run the scheduler inside the app process (self-hosted, single instance)
ENABLE_INTERNAL_SCHEDULER=false

# Maximum concurrent scans per app instance
MAX_CONCURRENT_SCANS=4

# ─── Payments ──────────────────────────────────────────────
# Click SHOP API credentials from the Click merchant cabinet. In the cabinet set
# the Prepare and Complete URLs to $APP_URL/api/payments/click/prepare and
# $APP_URL/api/payments/click/complete. Empty = Click is not live.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Simulated checkout for local testing. Ignored unless APP_URL is localhost or a
# private LAN address, so it can never be enabled on a public deployment.
PAYMENTS_MOCK=false
# Serve /api/openapi.json without signing in (default: Super Admins only).
API_DOCS_PUBLIC=false
# Production entry point is server.mjs (npm start). It reads the client IP from
# the socket; set TRUSTED_PROXY_COUNT=1 when running behind nginx/Caddy.
