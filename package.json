    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "scanner:sync-defaults": "tsx scripts/sync-scanner-defaults.ts",
    "scan": "tsx scripts/scan-cli.ts",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
